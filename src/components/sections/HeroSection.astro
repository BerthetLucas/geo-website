---
import { m } from '../../paraglide/messages.js';
---

<section id="top" class="px-10 pt-20 pb-16 text-center">
  <div class="mx-auto max-w-(--content-max)">
    <div class="mx-auto max-w-180">
      <h1
        class="text-ink my-0 mb-3.5 text-[clamp(38px,4.6vw,56px)] leading-[1.05] font-bold tracking-[-0.035em]"
      >
        {m.hero_title()}
      </h1>
      <p class="text-ink-3 my-0 mb-5 text-[18px] leading-normal">{m.hero_tagline()}</p>
      <p
        class="text-ink-3 [&_em]:text-ink mx-auto my-0 max-w-140 text-[15px] leading-[1.6] [&_em]:font-medium [&_em]:not-italic"
        set:html={m.hero_explainer()}
      />
    </div>
  </div>
</section>
