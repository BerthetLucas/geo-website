---
import { Image } from 'astro:assets';
import { m } from '../../paraglide/messages.js';
import FeatureCard from './FeatureCard.astro';
import FeatureNote from './FeatureNote.astro';
import SectionDivider from '../SectionDivider.astro';
import dashboard from '../../assets/dashboard.png';
import dataHistory from '../../assets/data-history.png';
---

<section id="features" class="px-7">
  <div class="mx-auto grid max-w-(--content-max) grid-cols-1 gap-11 md:grid-cols-2">
    <FeatureCard title={m.feature_daily_title()} body={m.feature_daily_body()}>
      <Image
        slot="visual"
        src={dashboard}
        alt={m.feature_daily_alt()}
        class="h-full w-full object-contain"
      />
    </FeatureCard>
    <FeatureCard title={m.feature_history_title()} body={m.feature_history_body()}>
      <Image
        slot="visual"
        src={dataHistory}
        alt={m.feature_history_alt()}
        class="h-full w-full object-contain"
      />
    </FeatureCard>
  </div>
</section>
<SectionDivider />
<section class="px-7">
  <div class="mx-auto grid max-w-(--content-max) grid-cols-1 gap-11 md:grid-cols-2">
    <FeatureNote
      title={m.feature_cost_title()}
      body={m.feature_cost_body()}
      detail={m.feature_cost_detail()}
    />
    <FeatureNote
      title={m.feature_mentions_title()}
      body={m.feature_mentions_body()}
      detail={m.feature_mentions_detail()}
    />
  </div>
</section>
