---
import { m } from '../../paraglide/messages.js';
import ExplainerPoint from './ExplainerPoint.astro';
---

<section id="geo" class="border-border-token bg-surface-band border-t px-7 py-18">
  <div
    class="mx-auto grid max-w-(--content-max) grid-cols-1 items-start gap-12 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] md:gap-20"
  >
    <div class="flex flex-col gap-5 md:sticky md:top-24">
      <h2
        class="text-ink my-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold tracking-[-0.028em]"
      >
        {m.geo_title()}
      </h2>
      <p
        class="text-ink-2 [&_em]:text-ink my-0 max-w-[46ch] text-[16px] leading-[1.6] [&_em]:font-medium [&_em]:not-italic"
        set:html={m.geo_lead()}
      />
    </div>
    <div class="grid gap-5">
      <ExplainerPoint index={1} title={m.geo_point_1_title()} body={m.geo_point_1_body()} />
      <ExplainerPoint index={2} title={m.geo_point_2_title()} body={m.geo_point_2_body()} />
      <ExplainerPoint index={3} title={m.geo_point_3_title()} body={m.geo_point_3_body()} />
    </div>
  </div>
</section>
