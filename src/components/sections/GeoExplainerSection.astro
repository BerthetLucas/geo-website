---
import { m } from '../../paraglide/messages.js';
import ExplainerPoint from './ExplainerPoint.astro';
---
<section id="geo" class="border-t border-border-token bg-surface-band px-7 py-18">
  <div class="mx-auto grid max-w-[var(--content-max)] grid-cols-1 items-start gap-12 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] md:gap-20">
    <h2 class="my-0 text-[clamp(26px,2.8vw,36px)] font-bold leading-[1.15] tracking-[-0.028em] text-ink">
      {m.geo_title()}
    </h2>
    <div class="grid gap-6.5">
      <p class="my-0 text-[16.5px] leading-[1.65] text-ink-2" set:html={m.geo_lead()} />
      <div class="grid gap-4 border-t border-[var(--border-2)] pt-5.5">
        <ExplainerPoint title={m.geo_point_1_title()} body={m.geo_point_1_body()} />
        <ExplainerPoint title={m.geo_point_2_title()} body={m.geo_point_2_body()} />
        <ExplainerPoint title={m.geo_point_3_title()} body={m.geo_point_3_body()} />
      </div>
    </div>
  </div>
</section>
