---
// Two fixed, non-interactive layers behind all content: an animated 56px grid
// and a 28px dot field, both radial-masked to fade below the hero.
---
<div class="gc-bg gc-bg--grid" aria-hidden="true"></div>
<div class="gc-bg gc-bg--dots" aria-hidden="true"></div>

<style>
  .gc-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .gc-bg--grid {
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    animation: gcgrid 22s linear infinite;
    mask-image: radial-gradient(115% 85% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 78%);
    -webkit-mask-image: radial-gradient(115% 85% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 78%);
  }

  .gc-bg--dots {
    background-image: radial-gradient(var(--dot) 1.4px, transparent 1.4px);
    background-size: 28px 28px;
    opacity: 0.5;
    animation: gcdots 30s linear infinite;
    mask-image: radial-gradient(100% 70% at 50% 8%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(100% 70% at 50% 8%, #000 0%, transparent 70%);
  }
</style>
