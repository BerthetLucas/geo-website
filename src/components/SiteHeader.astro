---
import { m } from '../paraglide/messages.js';
import { localizeHref, deLocalizeHref } from '../paraglide/runtime.js';
import ThemeToggle from './ThemeToggle.tsx';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.tsx';
import LogoMark from './icons/LogoMark.astro';
import { APP_URL } from '../constants/urls';

const currentLocale = Astro.currentLocale ?? 'fr';

const loginHref = `${APP_URL}/${currentLocale}/login`;
const registerHref = `${APP_URL}/${currentLocale}/register`;

const mobileLinks = [
  { href: loginHref, label: m.header_login() },
  { href: registerHref, label: m.header_register() },
];

const basePath = deLocalizeHref(Astro.url.pathname);
const localeNames: Record<'fr' | 'en', string> = {
  fr: m.language_name_fr(),
  en: m.language_name_en(),
};
const localeLinks = (['fr', 'en'] as const).map((locale) => ({
  locale,
  label: localeNames[locale],
  href: localizeHref(basePath, { locale }),
  current: locale === currentLocale,
}));
---

<header
  class="relative z-50 mx-auto flex max-w-(--content-max) items-center justify-between gap-6 px-7 py-5.5"
>
  <a href="#top" aria-label={m.header_home_aria()} class="flex items-center gap-2.25">
    <LogoMark class="text-accent" />
    <span class="text-ink text-[15px] font-semibold tracking-[-0.015em]">GEO Compass</span>
  </a>

  <div class="flex items-center gap-3">
    <ThemeToggle client:idle label={m.theme_toggle_label()} />

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher />
      <a
        href={loginHref}
        class="bg-surface-chip text-ink rounded-[9px] px-4 py-2.25 text-[13.5px] font-medium transition-colors hover:bg-[var(--surface-chip-hover)]"
        >{m.header_login()}</a
      >
      <a
        href={registerHref}
        class="bg-surface-chip text-ink rounded-[9px] px-4 py-2.25 text-[13.5px] font-medium transition-colors hover:bg-[var(--surface-chip-hover)]"
        >{m.header_register()}</a
      >
    </div>

    <div class="flex items-center md:hidden">
      <MobileNav
        client:media="(max-width: 767px)"
        navLabel={m.header_nav_label()}
        openLabel={m.header_menu_open()}
        closeLabel={m.header_menu_close()}
        links={mobileLinks}
        localeLinks={localeLinks}
      />
    </div>
  </div>
</header>
